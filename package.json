{
  "name": "mgi-web",
  "version": "1.0.0",
  "private": false,
  "description": "MGI (Multi Game Interpreter) — a web based interpreter for LucasArts SCUMM and Sierra AGI adventure games, written in TypeScript",
  "keywords": [
    "mgi",
    "scumm",
    "agi",
    "scummvm",
    "adventure",
    "lucasarts",
    "sierra",
    "interpreter",
    "typescript",
    "canvas"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Adrian Eyre",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianeyre/multi-game-interpreter.git"
  },
  "bugs": {
    "url": "https://github.com/adrianeyre/multi-game-interpreter/issues"
  },
  "homepage": "https://github.com/adrianeyre/multi-game-interpreter#readme",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/mgi-web.js",
  "module": "./dist/mgi-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mgi-web.js"
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "serve": "vite preview --host --port 4173",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"bin/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"bin/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "semantic-release": "semantic-release",
    "build:game": "vite-node bin/scumm-build.ts --",
    "diagnose": "vite-node bin/scumm-diagnose.ts --",
    "diagnose:sci": "vite-node bin/sci-diagnose.ts --",
    "shot": "vite-node bin/scumm-shot.ts --",
    "shot:agi": "vite-node bin/agi-shot.ts --",
    "shot:sci": "vite-node bin/sci-shot.ts --",
    "play:sci": "vite-node bin/sci-play.ts --",
    "rooms:sci": "vite-node bin/sci-rooms.ts --",
    "shot:agos": "vite-node bin/agos-shot.ts --",
    "shot:sky": "vite-node bin/sky-shot.ts --",
    "sweep": "vite-node bin/scumm-sweep.ts --",
    "sweep:agi": "vite-node bin/agi-sweep.ts --",
    "sweep:agos": "vite-node bin/agos-sweep.ts --",
    "sweep:sci": "vite-node bin/sci-sweep.ts --",
    "sweep:vt": "vite-node bin/vt-sweep.ts --",
    "play:vt": "vite-node bin/vt-playthrough.ts --",
    "play:sword": "vite-node bin/sword-playthrough.ts --",
    "probe": "vite-node bin/play-probe.ts --",
    "unrecovered": "vite-node bin/scumm-unrecovered.ts --",
    "reexport": "vite-node bin/scumm-reexport.ts --",
    "reexport:agi": "vite-node bin/agi-reexport.ts --",
    "reexport:agos": "vite-node bin/agos-reexport.ts --",
    "check:agos-art": "vite-node bin/agos-art-check.ts --",
    "reexport:sci": "vite-node bin/sci-reexport.ts --",
    "reexport:sword": "vite-node bin/sword-reexport.ts --",
    "fetch:agi": "vite-node bin/fetch-agi.ts --",
    "fetch:agos": "vite-node bin/fetch-agos.ts --",
    "fetch:sci": "vite-node bin/fetch-sci.ts --",
    "fetch:vt": "vite-node bin/fetch-vt.ts --",
    "render:agi": "vite-node bin/agi-render.ts --",
    "gen:agos-tables": "vite-node bin/agos-gen-tables.ts --",
    "gen:sludge-tables": "vite-node bin/sludge-gen-tables.ts --",
    "gen:lure-tables": "vite-node bin/lure-gen-tables.ts --",
    "gen:sword1-tables": "vite-node bin/sword1-gen-tables.ts --",
    "gen:sword2-tables": "vite-node bin/sword2-gen-tables.ts --",
    "sweep:sword": "vite-node bin/sword-sweep.ts --",
    "build:demo": "vite-node bin/scumm-build.ts -- examples/demo/game.ts --name demo",
    "fixture": "vite-node bin/fixture-install.ts --"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
